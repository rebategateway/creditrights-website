---
import { CHECK_URL, FREE_ROUTE } from '../data/site';
interface Props { heading?: string; sub?: string }
const { heading = 'Find out if you can claim. It takes a few minutes.', sub = 'Free to check. No documents, no credit check.' } = Astro.props;
---
<section class="wrap" aria-labelledby="cl-t" data-nosnippet>
  <div class="closing">
    <div class="cl-copy"><h2 id="cl-t">{heading}</h2><p>{sub}</p></div>
    <div class="cl-act"><a class="btn btn-slate" href={CHECK_URL} rel="sponsored">Check if I can claim</a><p>{FREE_ROUTE}</p></div>
  </div>
</section>
