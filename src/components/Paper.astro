---
// A small "paper document" illustration, the site's visual motif.
interface Row { a: string; b?: string; c?: string; hl?: boolean; strike?: boolean }
interface Props { title: string; sub?: string; rows: Row[]; foot?: string; tilt?: number; tag?: string }
const { title, sub, rows, foot = 'Illustration only.', tilt = -1.5, tag } = Astro.props;
---
<figure class="paper pp" style={`transform: rotate(${tilt}deg)`} aria-hidden="true">
  {tag && <p class="pp-tag">{tag}</p>}
  <div class="pp-h"><div><b>{title}</b>{sub && <span>{sub}</span>}</div><span>Illustration</span></div>
  <ul class="pp-rows">
    {rows.map((r) => (
      <li class:list={{ hl: r.hl }}>
        <time>{r.a}</time>
        <span>{r.strike ? <s>{r.b}</s> : r.b}</span>
        {r.c && <b>{r.c}</b>}
      </li>
    ))}
  </ul>
  {foot && <small>{foot}</small>}
</figure>
<style>
  .pp { margin: 0; padding: 26px 26px 18px; display: flex; flex-direction: column; gap: 8px; width: 100%; max-width: 420px; position: relative; }
  .pp-tag { position: absolute; left: 20px; top: -18px; background: var(--slate); color: var(--on); border-radius: 12px; padding: 8px 14px; font-weight: 700; font-size: 14px; box-shadow: 0 12px 28px rgba(18,24,32,.3); }
  .pp-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .pp-h b { display: block; font-size: 16px; color: var(--slate); }
  .pp-h span { font-size: 12px; color: var(--muted); }
  .pp-h div span { display: block; margin-top: 2px; }
  .pp-rows { list-style: none; margin: 0; padding: 0; }
  .pp-rows li { display: grid; grid-template-columns: auto minmax(0,1fr) auto; gap: 12px; align-items: center; padding: 10px 0; font-size: 15px; border-bottom: 1px solid #F1F2F3; color: var(--text); }
  .pp-rows li:last-child { border-bottom: 0; }
  .pp-rows time { color: var(--muted); font-size: 13px; min-width: 34px; }
  .pp-rows time:empty { min-width: 0; margin-right: -12px; }
  .pp-rows b { font-weight: 700; color: var(--tan-deep); font-variant-numeric: tabular-nums; }
  .pp-rows li.hl { background: var(--tan-pale); border-radius: 8px; margin: 2px -10px; padding: 10px; border-bottom: 0; font-weight: 700; color: var(--slate); }
  .pp-rows s { text-decoration-color: var(--tan); text-decoration-thickness: 3px; color: var(--muted); }
  .pp small { font-size: 11.5px; color: var(--muted); }
  @media (max-width: 1023px) {
    .pp { padding: 20px 18px 14px; }
    .pp-rows li { font-size: 14px; padding: 9px 0; }
  }
</style>
