---
import { NAV_FOOTER, SITE, SOURCE_NOTE } from '../data/site';
interface Props { under?: boolean }
const { under = true } = Astro.props;
const c = SITE.company;
---
<footer class:list={['ftr', { flat: !under }]}>
  <div class="wrap">
    <div class="ftr-top">
      <div class="ftr-about">
        <a class="logo" href="/" aria-label="CreditRights home">Credit<span>Rights</span></a>
        <p>Overdraft and irresponsible lending claims, introduced to our panel of legal partners.</p>
        <a class="contact" href="/contact/">Contact us online</a>
      </div>
      <nav class="cols" aria-label="Footer">
        {NAV_FOOTER.map((col) => (
          <div><h2>{col.heading}</h2><ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
        ))}
      </nav>
      <div class="folds">
        {NAV_FOOTER.map((col) => (
          <details class="fold"><summary>{col.heading}</summary><ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></details>
        ))}
      </div>
    </div>
    <div class="legal">
      <p><strong>{SITE.name} is a trading name of {c.legalName}, a claims management company authorised and regulated by the Financial Conduct Authority, FRN {c.frn}.</strong> Registered in {c.jurisdiction}, company no. {c.number}. Registered office: {c.address.street}, {c.address.locality} {c.address.postcode}. ICO registration {c.icoRef}.</p>
      <p>We introduce claims to our panel of legal partners, who pay us for each introduction. You can complain to your bank or lender and the Financial Ombudsman yourself for free.</p>
      <p><sup>1</sup> {SOURCE_NOTE}</p>
    </div>
  </div>
</footer>
