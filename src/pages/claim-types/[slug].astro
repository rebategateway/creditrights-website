---
// One guide page per claim type, built from src/data/claimTypes.ts.
import Base from '../../layouts/Base.astro';
import FaqList from '../../components/FaqList.astro';
import { CLAIM_TYPES } from '../../data/claimTypes';
import type { ClaimType } from '../../data/claimTypes';
import { LENDER_INFO } from '../../data/lenders';
import { CLAIM_NAV, FREE_ROUTE, PAYMENT_LINE, SITE, claimHref, lenderHref } from '../../data/site';
import { faqSchema } from '../../data/faqs';

export function getStaticPaths() {
  return CLAIM_TYPES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: ClaimType };
const nav = CLAIM_NAV.find((n) => n.slug === c.slug)!;
const path = claimHref(c.slug);
const url = new URL(path, SITE.url).href;
const lenders = LENDER_INFO.filter((l) => (nav.types as readonly string[]).includes(l.type)).sort((a, b) => a.name.localeCompare(b.name));
const related = CLAIM_NAV.filter((n) => n.slug !== c.slug);
const checked = new Date(`${c.checked}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const OPT_LABEL: Record<string, string> = { overdraft: 'Overdraft', card: 'Credit card', loan: 'Loan', catalogue: 'Catalogue account', guarantor: 'Guarantor or doorstep loan', car: 'Car finance', other: 'Not sure' };
const opts = [c.borrow, ...['overdraft', 'card', 'loan'].filter((b) => b !== c.borrow)].slice(0, 3).concat('other').map((b) => ({ label: OPT_LABEL[b], b }));
const Noun = nav.noun.charAt(0).toUpperCase() + nav.noun.slice(1);
const article = {
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: c.h1,
  description: c.description,
  datePublished: c.checked,
  dateModified: c.checked,
  inLanguage: 'en-GB',
  mainEntityOfPage: { '@id': `${url}#webpage` },
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  about: { '@type': 'Thing', name: `${Noun} irresponsible lending complaints` },
  mentions: [
    { '@type': 'Organization', name: 'Financial Ombudsman Service', url: 'https://www.financial-ombudsman.org.uk/' },
    { '@type': 'Organization', name: 'Financial Conduct Authority', url: 'https://www.fca.org.uk/' },
  ],
};
const toc = [
  ['what', 'What counts as unaffordable'], ['signs', 'Signs you could claim'], ['back', 'What you could get back'],
  ...(c.decisions.length ? [['decisions', 'Ombudsman decisions']] : []),
  ...(c.extra ? [[c.extra.id, c.extra.heading]] : []),
  ...(lenders.length ? [['lenders', 'Lenders we cover']] : []),
  ['questions', 'Questions'], ['yourself', 'How to complain'], ['sources', 'Sources'],
];
---
<Base
  path={path}
  title={c.title}
  description={c.description}
  active="types"
  crumbs={[{ name: 'What you can claim for', href: '/claim-types/' }, { name: nav.label, href: path }]}
  schema={[article, faqSchema(c.faqs, url)]}
>
  <section class="lhero" slot="hero" aria-labelledby="c-t">
    <div class="wrap lgrid">
      <div class="lcopy">
        <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/claim-types/">Claim types</a></li><li aria-current="page">{nav.label}</li></ol></nav>
        <h1 id="c-t">{c.h1}</h1>
        <div class="answer"><p class="eb">The short answer</p><p>{c.answer}</p></div>
        <p class="upd">Checked {checked} · <a href="#sources">Sources</a></p>
      </div>
      <aside class="lck" aria-labelledby="lck-t">
        <p class="prog">Question 1 of 4 <span aria-hidden="true"><i></i><i></i><i></i><i></i></span></p>
        <h2 id="lck-t">Check if you can claim</h2>
        <p class="lq">What did you borrow?</p>
        <div class="lopts">{opts.map((o) => <a href={`/check/?borrow=${o.b}`} class:list={{ main: o.b === c.borrow }}>{o.label}</a>)}</div>
        <small>{FREE_ROUTE} {PAYMENT_LINE}</small>
      </aside>
    </div>
  </section>

  <div class="wrap llift">
    <dl class="card facts">
      {c.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}{f.avg && <sup>1</sup>}</dd></div>)}
    </dl>
  </div>

  <div class="wrap article">
    <article class="card panel">
      <section id="what" aria-labelledby="what-t">
        <h2 id="what-t">What counts as unaffordable {nav.noun} lending</h2>
        {c.intro.map((t) => <p>{t}</p>)}
        <ul class="rules">{c.rules.map((r) => <li><b>{r.when}</b><span>{r.text}</span></li>)}</ul>
      </section>
      <section id="signs" aria-labelledby="signs-t">
        <h2 id="signs-t">Signs you could have a claim</h2>
        <ol class="slist">{c.signs.map((s, i) => <li><span class="num">{String(i + 1).padStart(2, '0')}</span><b>{s.title}</b><span>{s.text}</span></li>)}</ol>
      </section>
      <section id="back" aria-labelledby="back-t">
        <h2 id="back-t">What you could get back</h2>
        <div class="paper lput">
          <div class="pr-h"><b>{c.putRight.title}</b><span>Illustration</span></div>
          {c.putRight.rows.map(([a, b, strike]) => <p class="pr"><span>{strike ? <s>{a}</s> : a}</span><b>{b}</b></p>)}
        </div>
        {c.putRight.paras.map((t) => <p>{t}</p>)}
      </section>
      {c.decisions.length > 0 && (
        <section id="decisions" aria-labelledby="dec-t">
          <h2 id="dec-t">Ombudsman decisions on {nav.noun} complaints</h2>
          <p>Published Financial Ombudsman decisions show how these complaints are judged. Every complaint is decided on its own facts, so these are examples, not a guide to what you’ll get.</p>
          <ul class="decs">
            {c.decisions.map((d) => (
              <li>
                <p class="dtop"><span class:list={['out', { up: d.outcome !== 'Not upheld' }]}>{d.outcome}</span><span class="biz">{d.business}</span></p>
                <p>{d.summary}</p>
                <a href={d.url} rel="noopener">Read decision {d.ref}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {c.extra && (
        <section id={c.extra.id} aria-labelledby={`${c.extra.id}-t`}>
          <h2 id={`${c.extra.id}-t`}>{c.extra.heading}</h2>
          {c.extra.paras.map((t) => <p>{t}</p>)}
        </section>
      )}
      {lenders.length > 0 && (
        <section id="lenders" aria-labelledby="len-t">
          <h2 id="len-t">{c.lendersHeading ?? `${Noun} lenders we cover`}</h2>
          <p>Each page sets out who provides the credit, published ombudsman decisions about that lender, and how to complain to it.</p>
          <ul class="chips">{lenders.map((l) => <li><a href={lenderHref(l.slug)}>{l.name}</a></li>)}</ul>
          <p class="meta">Can’t see yours? The check covers any UK lender.</p>
        </section>
      )}
      <section id="questions" aria-labelledby="q-t">
        <h2 id="q-t">{Noun} claim questions</h2>
        <FaqList faqs={c.faqs} name="claim-faq" />
      </section>
      <section id="yourself" aria-labelledby="self-t">
        <h2 id="self-t">How to complain about {nav.noun === 'buy now, pay later' ? 'buy now, pay later' : `a ${nav.noun}`} yourself</h2>
        {c.complain.map((t) => <p set:html={t} />)}
      </section>
      <section id="sources" class="sources" aria-labelledby="src-t">
        <h2 id="src-t">Sources</h2>
        <ul>{c.sources.map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}</ul>
        <p class="meta">Checked {checked}. Rules and figures can change; the sources above are the authority.</p>
      </section>
    </article>
    <aside class="side">
      <div class="start">
        <h2>Start your {nav.noun} claim</h2>
        <p>Four questions. About a minute.</p>
        <a class="btn btn-tan" href={`/check/?borrow=${c.borrow}`}>Check if I can claim</a>
        <small>{FREE_ROUTE}</small>
      </div>
      <nav class="card box" aria-label="On this page">
        <h2>On this page</h2>
        <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
      </nav>
      <nav class="card box" aria-label="Other claim types">
        <h2>Other claim types</h2>
        <ul>{related.map((r) => <li><a href={claimHref(r.slug)}>{r.label}</a></li>)}</ul>
      </nav>
    </aside>
  </div>
</Base>

<style>
  .lhero { padding: 40px 0 128px; }
  .lgrid { display: grid; grid-template-columns: minmax(0,1fr) 400px; gap: 56px; align-items: start; }
  .lcopy { display: flex; flex-direction: column; gap: 20px; }
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--on-2); }
  .crumbs li + li::before { content: '/'; margin-right: 8px; color: var(--on-line); }
  .crumbs a { color: var(--on-2); }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pills span { font-size: 13px; font-weight: 700; color: var(--on); border: 1px solid var(--on-line); border-radius: 999px; padding: 5px 12px; }
  .pills .ok { color: #9BE3BC; display: inline-flex; align-items: center; gap: 7px; }
  .pills .ok::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #2FD07A; }
  .lhero h1 { font-size: 56px; color: var(--on); }
  .answer { background: rgba(255,255,255,.06); border: 1px solid var(--on-line); border-radius: var(--rm); padding: 22px 24px; max-width: 680px; display: flex; flex-direction: column; gap: 8px; }
  .answer .eb { color: var(--tan); }
  .answer p:last-child { font-size: 18px; line-height: 1.55; color: var(--on); }
  .upd { font-size: 14px; color: var(--on-2); }
  .upd a { color: var(--on-2); }
  .lck { background: var(--card); color: var(--text); border-radius: var(--rl); padding: 26px; box-shadow: 0 30px 60px rgba(6,10,16,.35); display: flex; flex-direction: column; gap: 14px; }
  .lck h2 { font-size: 23px; }
  .lq { font-weight: 700; font-size: 16px; }
  .lopts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .lopts a { display: flex; align-items: center; min-height: 56px; padding: 8px 14px; border: 1.5px solid var(--line); border-radius: var(--rs); font-weight: 700; font-size: 15px; color: var(--slate); text-decoration: none; }
  .lopts a.main { border-color: var(--slate); }
  .lopts a:hover { border-color: var(--slate); }
  .lck small { font-size: 13px; line-height: 1.45; color: var(--muted); }
  .llift { margin-top: -72px; position: relative; z-index: 3; }
  .facts { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); margin: 0; box-shadow: 0 20px 50px rgba(27,36,48,.08); overflow: hidden; }
  .facts div { padding: 22px 24px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .facts div:last-child { border-right: 0; }
  .facts dt { font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .facts dd { margin: 0; font-weight: 800; font-size: 17px; line-height: 1.25; color: var(--slate); }
  .article { display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 32px; align-items: start; margin-top: 32px; }
  .panel { padding: 52px 56px; display: flex; flex-direction: column; gap: 48px; }
  .panel section { display: flex; flex-direction: column; gap: 16px; max-width: 660px; scroll-margin-top: 24px; }
  .panel h2 { font-size: 30px; }
  .panel section > p { color: var(--text-2); }
  .panel section > p a { color: var(--slate); }
  .meta { font-size: 14px !important; color: var(--muted) !important; }
  .lnote { background: var(--tan-pale); border-radius: var(--rs); padding: 16px 18px; font-size: 16px; color: var(--slate); max-width: 660px; }
  .nlist li { font-size: 18px; padding: 14px 0; }
  .more { font-size: 15px; color: var(--text-2); }
  .more a { color: var(--slate); font-weight: 700; }
  .note { font-size: 15px; color: var(--muted) !important; background: var(--bg); border-radius: var(--rs); padding: 14px 16px; }
  .lput { padding: 24px 26px 16px; transform: rotate(-.8deg); max-width: 520px; box-shadow: 0 20px 44px rgba(18,24,32,.12); }
  .lput .pr:last-child { border-bottom: 0; }
  .decs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .decs li { border: 1px solid var(--line); border-radius: var(--rs); padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; }
  .out { align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; border-radius: 999px; padding: 4px 10px; background: #EEF0F2; color: var(--text-2); }
  .out.up { background: var(--tan-pale); color: var(--tan-deep); }
  .decs p { font-size: 16px; color: var(--text-2); }
  .decs a { font-size: 14px; font-weight: 700; color: var(--slate); }
  .sources ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
  .side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 24px; }
  .start { background: var(--slate); color: var(--on); border-radius: var(--rm); padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .start h2 { font-size: 21px; color: var(--on); }
  .start p { font-size: 15px; color: var(--on-2); }
  .start .btn { width: 100%; }
  .start small { font-size: 12px; line-height: 1.45; color: var(--on-2); }
  .box { padding: 20px 22px; }
  .box h2 { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  .box ol, .box ul { list-style: none; margin: 0; padding: 0; }
  .box a { display: block; padding: 9px 0; color: var(--slate); font-weight: 600; font-size: 15px; text-decoration: none; border-bottom: 1px solid #F1F2F3; }
  .box li:last-child a { border-bottom: 0; }
  .box a:hover { color: var(--tan-deep); }
  .others { margin-top: 72px; }
  .others h2 { font-size: 32px; margin-bottom: 20px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: block; padding: 9px 16px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); font-weight: 600; font-size: 15px; color: var(--slate); text-decoration: none; }
  .chips a:hover { border-color: var(--tan); }
  @media (max-width: 1023px) {
    .lhero { padding: 22px 0 100px; }
    .lgrid { grid-template-columns: minmax(0,1fr); gap: 24px; }
    .lhero h1 { font-size: 34px; }
    .answer { padding: 18px; }
    .answer p:last-child { font-size: 16px; }
    .lck { padding: 20px; border-radius: 24px; }
    .llift { margin-top: -64px; }
    .facts { grid-template-columns: 1fr 1fr; }
    .facts div { padding: 16px; }
    .facts div:nth-child(2) { border-right: 0; }
    .facts div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
    .facts dd { font-size: 15px; }
    .article { grid-template-columns: minmax(0,1fr); gap: 16px; margin-top: 16px; }
    .panel { padding: 24px 20px; gap: 36px; }
    .panel h2 { font-size: 25px; }
    .nlist li { font-size: 16px; }
    .lput { padding: 18px 16px 12px; }
    .side { position: static; }
    .others { margin-top: 64px; }
    .others h2 { font-size: 26px; }
    .chips a { font-size: 14px; padding: 8px 14px; }
  }
  .rules { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rules li { display: grid; grid-template-columns: 132px minmax(0,1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 16px; color: var(--text-2); }
  .rules b { font-size: 13px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--tan-deep); padding-top: 2px; }
  .slist { list-style: none; margin: 0; padding: 0; counter-reset: s; display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .slist li { display: grid; grid-template-columns: 40px minmax(0,1fr); gap: 4px 12px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .slist .num { grid-row: span 2; font-weight: 800; color: var(--tan-deep); font-size: 15px; padding-top: 2px; }
  .slist b { font-size: 18px; color: var(--slate); }
  .slist span:not(.num) { font-size: 16px; color: var(--text-2); }
  .decs .biz { font-size: 13px; font-weight: 700; color: var(--muted); }
  .dtop { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  @media (max-width: 1023px) {
    .rules li { grid-template-columns: minmax(0,1fr); gap: 4px; }
    .slist b { font-size: 16px; }
  }
</style>
