---
import Base from '../../layouts/Base.astro';
---
<Base path="/opt-out/done/" title="Letters stopped | CreditRights" description="We’ve got your request to stop our letters and won’t write to you again. If a letter was already on its way, please ignore it." noindex>
  <section class="phero" slot="hero">
    <div class="wrap">
      <p class="eb">Your letters</p>
      <h1>Done. We won’t write to you again.</h1>
      <p class="pintro">We’ve added you to our do-not-mail list. If a letter was already on its way, please ignore it.</p>
    </div>
  </section>
  <div class="wrap" style="padding-top:48px"><a class="btn btn-slate" href="/">Back to the homepage</a></div>
</Base>
