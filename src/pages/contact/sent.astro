---
import Base from '../../layouts/Base.astro';
---
<Base path="/contact/sent/" title="Message sent | CreditRights" description="Thanks for your message. We'll reply by email." noindex>
  <section class="phero" slot="hero">
    <div class="wrap">
      <p class="eb">Message sent</p>
      <h1>Thanks. We’ve got your message.</h1>
      <p class="pintro">We’ll reply by email. If you asked us to stop sending letters, we’ll take you off our mailing list.</p>
    </div>
  </section>
  <div class="wrap" style="padding-top:48px"><a class="btn btn-slate" href="/">Back to the homepage</a></div>
</Base>
