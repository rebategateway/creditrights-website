---
import Base from '../layouts/Base.astro';
---
<Base path="/404/" title="Page not found | CreditRights" description="We couldn't find that page. Check if you can claim, or find your bank or lender." noindex>
  <section class="ph-hero" slot="hero">
    <div class="wrap"><p class="eb">Error 404</p><h1>We can’t find that page</h1></div>
  </section>
  <div class="wrap">
    <div class="ph-body">
      <p>It may have moved, or the link may be wrong.</p>
      <p><a class="more" href="/">Go to the homepage</a></p>
      <p><a class="more" href="/banks-and-lenders/">Find your bank or lender</a></p>
    </div>
  </div>
</Base>
