---
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import { CHECK_URL, FREE_ROUTE, PAYMENT_LINE, SITE } from '../data/site';
import { faqSchema } from '../data/faqs';
import type { Faq } from '../data/faqs';
const c = SITE.company;
const faqs: Faq[] = [
  { q: 'Why did I get a letter?', a: 'We write to people who may have had overdrafts, loans or cards that could be worth looking into. We don’t know anything about your accounts, so the only way to find out is to check.' },
  { q: 'Do I have to respond?', a: 'No. If you’re not interested, you don’t need to do anything.' },
  { q: 'Is this a scam?', a: `No. ${SITE.name} is a trading name of ${c.legalName}, authorised by the Financial Conduct Authority (FRN ${c.frn}). You can check us on the FCA register. We will never ask for your bank login, card details or any payment.` },
  { q: 'How did you get my name and address?', a: 'Your letter explains where your details came from. Our privacy policy explains how we use them and your rights, including how to stop our letters.', link: { kind: 'Privacy', label: 'Read our privacy policy', href: '/privacy-policy/#letters' } },
  { q: 'Do I need my reference?', a: 'It links your check to your letter, so we can show the name and address we wrote to. Lost your letter? You can still check without it.' },
  { q: 'Does it cost anything?', a: 'Checking is free and we never charge you. If you go ahead with a claim, our legal partner only charges if it succeeds, and its fee is capped by the regulator.', link: { kind: 'Fees', label: 'See the fee table', href: '/fees/' } },
  { q: 'How do I stop getting letters?', a: 'Give us the name and address we wrote to on our stop-our-letters page, or write to us at our registered office, and we won’t write to you again.', link: { kind: 'Letters', label: 'Stop our letters', href: '/opt-out/' } },
];
---
<Base path="/received-a-letter/" title="Received a letter from CreditRights? | CreditRights"
  description="Had a letter from CreditRights? Find out why we wrote, check in a minute whether you could claim back overdraft or loan charges, or stop future letters."
  schema={[faqSchema(faqs, `${SITE.url}/received-a-letter/`)]}>
  <section class="lhero" slot="hero" aria-labelledby="rl-t">
    <div class="wrap rl-grid">
      <div class="rl-copy">
        <p class="eb">Received a letter?</p>
        <h1 id="rl-t">Had a letter from us? Here’s what it means.</h1>
        <p class="lead">We wrote to you because you may have had an overdraft, loan or card that you couldn’t really afford. If so, you could be owed back the interest and charges. Enter the reference from your letter to start: it takes about a minute.</p>
        <div class="rl-where">
          <p class="rl-wh">Where to find your reference</p>
          <div class="rl-wb">
            <div class="mini" aria-hidden="true">
              <div class="mini-h"><span class="mini-logo">Credit<b>Rights</b></span><span class="mini-ref">Your reference <b>CR-48203917</b></span></div>
              <i></i><i></i><i class="s"></i>
            </div>
            <p>Top right of your letter, starting <b>CR-</b>. It links your check to your letter.</p>
          </div>
        </div>
      </div>
      <section id="start" class="card rl-form" aria-labelledby="rl-f">
        <form action={CHECK_URL} method="get" data-ref-form data-go={CHECK_URL} novalidate>
          <h2 id="rl-f">Enter your reference</h2>
          <label class="rl-l"><span class="vh">Reference from your letter</span>
            <span class="rl-in"><span class="rl-pre" aria-hidden="true">CR-</span><input name="ref" inputmode="numeric" autocomplete="off" maxlength="14" placeholder="48203917" /></span>
          </label>
          <p class="rl-err" data-err role="alert" hidden>Enter the numbers after CR- on your letter.</p>
          <button class="btn btn-tan" type="submit">Continue</button>
          <p class="rl-small">About a minute · No documents · No credit check</p>
        </form>
        <a class="rl-lost" href={`${CHECK_URL}&utm_content=letter`} rel="sponsored"><span><b>Lost your letter?</b> Start without a reference</span><span aria-hidden="true">→</span></a>
      </section>
    </div>
  </section>

  <section class="wrap sec rl-why" aria-labelledby="why-t">
    <div class="rl-two">
      <div>
        <p class="eb">Why we wrote</p>
        <h2 id="why-t">You may have been lent money you couldn’t afford</h2>
      </div>
      <div class="rl-txt">
        <p>Banks and lenders are supposed to check you can afford what they lend, and to step in when you’re struggling. When they don’t, they have to put it right: refunding interest and charges, adding interest, and correcting your credit file.</p>
        <p>We don’t know anything about your accounts. Our letter is an invitation to check, nothing more. If you’re not interested, you don’t need to do anything.</p>
        <ul class="nlist">
          <li><span class="num">01</span>In your overdraft most of every month</li>
          <li><span class="num">02</span>Your limit went up while you were struggling</li>
          <li><span class="num">03</span>Borrowing again to pay off borrowing</li>
          <li><span class="num">04</span>Missed payments, and the charges kept coming</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="full white" aria-labelledby="next-t">
    <div class="wrap">
      <div class="sh"><div><p class="eb">What happens next</p><h2 id="next-t">Three steps, and you only do the first</h2></div></div>
      <ol class="steps rl-steps">
        <li><span class="sn on">01</span><h3>Check</h3><p>Four quick questions. About a minute.</p></li>
        <li><span class="sn">02</span><h3>We introduce you</h3><p>To Claims &amp; Refunds, which passes your claim to Recoup, a firm of solicitors.</p></li>
        <li><span class="sn">03</span><h3>They do the rest</h3><p>They check your accounts securely, then complain to your bank or lender for you.</p></li>
      </ol>
      <p class="rl-more"><a class="more" href="/how-it-works/">How a claim works</a></p>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="real-t">
    <div class="rl-two">
      <div>
        <p class="eb">Is this genuine?</p>
        <h2 id="real-t">Who we are</h2>
      </div>
      <div class="rl-txt">
        <dl class="card rl-facts">
          <div><dt>Company</dt><dd>{c.legalName}, trading as {SITE.name}</dd></div>
          <div><dt>Regulated by</dt><dd>Financial Conduct Authority, FRN {c.frn}</dd></div>
          <div><dt>Company number</dt><dd>{c.number}</dd></div>
          <div><dt>Data protection</dt><dd>ICO {c.icoRef}</dd></div>
        </dl>
        <p>You can check us on the <a href={`https://register.fca.org.uk/s/firm?id=${c.frn}`} rel="noopener">FCA register</a>. We will never ask for your bank login, card details or any payment. <a href="/about-us/">More about CreditRights</a>.</p>
        <p class="rl-free">{FREE_ROUTE} {PAYMENT_LINE}</p>
      </div>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="rlq-t">
    <div class="faq">
      <div>
        <div class="sh"><div><p class="eb">Questions</p><h2 id="rlq-t">About your letter</h2></div></div>
        <p class="help">Don’t want any more letters? <a href="/opt-out/">Stop our letters</a> and we won’t write to you again.</p>
      </div>
      <FaqList faqs={faqs} name="letter-faq" />
    </div>
  </section>
</Base>

<style>
  .lhero { padding: 56px 0 96px; }
  .rl-grid { display: grid; grid-template-columns: minmax(0,1fr) 420px; gap: 64px; align-items: center; }
  .rl-copy { display: flex; flex-direction: column; gap: 22px; }
  .rl-copy .eb { color: var(--tan); }
  .rl-copy h1 { font-size: 60px; color: var(--on); }
  .rl-form { padding: 0; display: flex; flex-direction: column; border-radius: var(--rl); box-shadow: 0 30px 60px rgba(6,10,16,.35); overflow: hidden; }
  .rl-form form { padding: 28px; display: flex; flex-direction: column; gap: 16px; }
  .rl-form h2 { font-size: 24px; }
  .rl-l { display: block; }
  .rl-in { display: flex; align-items: center; height: 56px; border: 1.5px solid var(--line); border-radius: 12px; padding: 0 14px; gap: 6px; background: #fff; }
  .rl-in:focus-within { border-color: var(--slate); box-shadow: inset 0 0 0 1px var(--slate); }
  .rl-pre { font-weight: 800; font-size: 18px; color: var(--slate); letter-spacing: .04em; }
  .rl-in input { flex: 1; min-width: 0; height: 100%; border: 0; outline: none; background: transparent; font: inherit; font-size: 18px; font-weight: 700; letter-spacing: .06em; color: var(--slate); }
  .rl-in input::placeholder { font-weight: 500; letter-spacing: .06em; color: #9AA1AA; }
  .rl-err { font-size: 14px; font-weight: 600; color: #B42318; }
  .rl-form .btn { width: 100%; }
  .rl-small { font-size: 13px; color: var(--muted); text-align: center; }
  .rl-lost { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 28px; border-top: 1px solid var(--line); background: var(--bg); font-size: 14px; color: var(--text-2); text-decoration: none; }
  .rl-lost b { color: var(--slate); }
  .rl-lost:hover b { text-decoration: underline; }
  .rl-where { display: flex; flex-direction: column; gap: 12px; max-width: 560px; }
  .rl-wh { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--on-2); }
  .rl-wb { display: flex; gap: 18px; align-items: center; }
  .rl-wb > p { font-size: 15px; line-height: 1.5; color: var(--on-2); }
  .rl-wb > p b { color: var(--on); }
  .mini { width: 210px; flex-shrink: 0; background: #fff; border-radius: 8px; padding: 12px 12px 14px; display: flex; flex-direction: column; gap: 7px; box-shadow: 0 12px 30px rgba(6,10,16,.35); transform: rotate(-2deg); }
  .mini-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 4px; }
  .mini-logo { font-size: 10px; font-weight: 800; color: var(--slate); letter-spacing: -.02em; }
  .mini-logo b { color: var(--tan); }
  .mini-ref { font-size: 7.5px; color: var(--muted); text-align: right; line-height: 1.3; }
  .mini-ref b { display: block; font-size: 9.5px; color: var(--slate); background: var(--tan-pale); border-radius: 3px; padding: 1px 3px; margin-top: 1px; }
  .mini i { display: block; height: 5px; border-radius: 3px; background: #E3E5E8; }
  .mini i.s { width: 60%; }
  .rl-two { display: grid; grid-template-columns: minmax(0,5fr) minmax(0,7fr); gap: 64px; align-items: start; }
  .rl-two h2 { font-size: 40px; margin-top: 12px; }
  .rl-txt { display: flex; flex-direction: column; gap: 18px; }
  .rl-txt > p { font-size: 18px; color: var(--text-2); }
  .rl-txt a { color: var(--slate); }
  .rl-steps { grid-template-columns: repeat(3,minmax(0,1fr)); }
  .rl-more { margin-top: 32px; }
  .rl-facts { margin: 0; display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; }
  .rl-facts div { padding: 18px 20px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
  .rl-facts div:nth-child(odd) { border-right: 1px solid var(--line); }
  .rl-facts div:nth-last-child(-n+2) { border-bottom: 0; }
  .rl-facts dt { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .rl-facts dd { margin: 0; font-weight: 700; color: var(--slate); }
  .rl-free { font-size: 15px !important; color: var(--muted) !important; }
  @media (max-width: 1023px) {
    .lhero { padding: 28px 0 56px; }
    .rl-grid { grid-template-columns: minmax(0,1fr); gap: 28px; }
    .rl-copy h1 { font-size: 36px; }
    .rl-form { border-radius: 24px; }
    .rl-form form { padding: 20px; }
    .rl-lost { padding: 14px 20px; }
    .mini { width: 150px; }
    .rl-wb > p { font-size: 14px; }
    .rl-two { grid-template-columns: minmax(0,1fr); gap: 16px; }
    .rl-two h2 { font-size: 30px; }
    .rl-txt > p { font-size: 16px; }
    .rl-steps { grid-template-columns: minmax(0,1fr); }
    .rl-facts { grid-template-columns: 1fr; }
    .rl-facts div:nth-child(odd) { border-right: 0; }
    .rl-facts div:nth-last-child(2) { border-bottom: 1px solid var(--line); }
  }
</style>

<script>
  // The reference is checked here first (as on Report Repair): unknown references get an error
  // instead of slipping through. Found: on to the check, which shows the name and address we
  // wrote to (check/index.astro, worker/letter.ts).
  const f = document.querySelector<HTMLFormElement>('[data-ref-form]');
  let sending = false;
  f?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (sending) return;
    const i = f.querySelector<HTMLInputElement>('input[name="ref"]')!;
    const er = f.querySelector<HTMLElement>('[data-err]')!;
    const say = (t: string) => { er.textContent = t; er.hidden = !t; if (t) i.focus(); };
    i.value = i.value.replace(/^\s*CR\s*-?/i, '').replace(/[^0-9A-Za-z]/g, '');
    if (!/^[0-9A-Za-z]{3,12}$/.test(i.value)) return say('Enter the numbers after CR- on your letter.');
    sending = true; say('');
    const r = await fetch('/api/letter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ref: i.value }) }).catch(() => null);
    const d = r && r.ok ? await r.json().catch(() => null) as { found?: boolean } | null : null;
    sending = false;
    if (r && r.status === 429) return say('Too many tries. Please wait an hour and try again, or start without a reference.');
    if (r && r.ok && !d?.found) return say('We can’t find that reference. Check the numbers after CR- on your letter, or start without a reference below.');
    // Our own check is off for now (CHECK_URL in site.ts): the reference goes with them for tracking.
    location.href = `${f.dataset.go}&utm_content=CR-${encodeURIComponent(i.value)}`;
  });
</script>
