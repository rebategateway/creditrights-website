---
// Lender page template, built first for Barclays.
// TODO before launch: verify entity and status facts against the FCA
// register, add the author byline and final sources.
import Base from '../../layouts/Base.astro';
import FaqList from '../../components/FaqList.astro';
import { AVERAGES, LENDERS, SITE, lenderHref } from '../../data/site';
import { faqSchema } from '../../data/faqs';
import type { Faq } from '../../data/faqs';

const path = '/banks-and-lenders/barclays/';
const faqs: Faq[] = [
  { q: 'Can I claim if I’m still overdrawn?', a: 'Yes. If the complaint is upheld, the refund may reduce your balance.' },
  { q: 'Can I claim if I’ve closed the account?', a: 'Yes, subject to time limits.' },
  { q: 'How long does Barclays have to reply?', a: 'Eight weeks. After that, the complaint can go to the Financial Ombudsman.' },
];
const others = LENDERS.filter((l) => l.type === 'overdraft' && l.slug !== 'barclays');
---
<Base
  path={path}
  active="lenders"
  crumbs={[{ name: 'Banks and lenders', href: '/banks-and-lenders/' }, { name: 'Barclays', href: path }]}
  schema={[faqSchema(faqs, new URL(path, SITE.url).href)]}
>
  <section class="lhero" slot="hero" aria-labelledby="l-t">
    <div class="wrap lgrid">
      <div class="lcopy">
        <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/banks-and-lenders/">Banks and lenders</a></li><li aria-current="page">Barclays</li></ol></nav>
        <h1 id="l-t">Barclays overdraft refund claims</h1>
        <div class="answer"><p class="eb">The short answer</p><p>If you relied on your Barclays overdraft month after month, or your limit went up while you were struggling, you could be owed back the interest and charges. Complaints go to Barclays first, then to the Financial Ombudsman.</p></div>
      </div>
      <aside class="lck" aria-labelledby="lck-t">
        <p class="prog">Question 1 of 4 <span aria-hidden="true"><i></i><i></i><i></i><i></i></span></p>
        <h2 id="lck-t">Bank with Barclays? Check if you can claim.</h2>
        <p class="lq">What did you have with Barclays?</p>
        <div class="lopts">
          <a href="/check/?borrow=overdraft">Overdraft</a>
          <a href="/check/?borrow=card">Credit card</a>
          <a href="/check/?borrow=loan">Loan</a>
          <a href="/check/?borrow=other">Not sure</a>
        </div>
        <small>You can complain to Barclays and the Financial Ombudsman yourself for free. Our legal partners pay us when we introduce your claim.</small>
      </aside>
    </div>
  </section>

  <div class="wrap llift">
    <dl class="card facts">
      <div><dt>Owned by</dt><dd>Barclays PLC</dd></div>
      <div><dt>Products</dt><dd>Current accounts, overdrafts, cards, loans</dd></div>
      <div><dt>Average overdraft claim</dt><dd>{AVERAGES.overdraft}<sup>1</sup></dd></div>
      <div><dt>Complain to</dt><dd>Barclays, then the Financial Ombudsman</dd></div>
    </dl>
  </div>

  <div class="wrap article">
    <article class="card panel">
      <section id="who" aria-labelledby="who-t">
        <h2 id="who-t">Who are Barclays?</h2>
        <p>Barclays is one of the UK’s largest high street banks. Its personal current accounts and overdrafts are provided by Barclays Bank UK PLC, part of the Barclays PLC group.</p>
        <p>Barclays is still trading and regulated by the FCA. Complain to Barclays first. If you’re unhappy with its answer, or it hasn’t replied within eight weeks, you can go to the Financial Ombudsman.</p>
      </section>
      <section id="claim" aria-labelledby="claim-t">
        <h2 id="claim-t">Can I claim against Barclays?</h2>
        <p>You could, if any of these sound familiar:</p>
        <ol class="nlist">
          <li><span class="num">01</span>In your overdraft most of every month</li>
          <li><span class="num">02</span>Wages in, straight back into the red</li>
          <li><span class="num">03</span>Your limit went up while you were maxed out</li>
          <li><span class="num">04</span>Charges kept coming, and nobody got in touch</li>
        </ol>
        <p class="note"><b>Limit increases count too.</b> Each one was a lending decision, so each can be looked at.</p>
      </section>
      <section id="back" aria-labelledby="back-t">
        <h2 id="back-t">What you could get back</h2>
        <div class="paper lput">
          <div class="pr-h"><b>Your Barclays account, put right</b><span>Illustration</span></div>
          <p class="pr"><span><s>Overdraft interest</s></span><b>Refunded</b></p>
          <p class="pr"><span><s>Fees and charges</s></span><b>Refunded</b></p>
          <p class="pr"><span>Interest on your refund</span><b>Added</b></p>
          <p class="pr"><span><s>Missed payment markers</s></span><b>Removed</b></p>
        </div>
        <p>Refunds usually run from when the bank should have stepped in. If you’re still overdrawn, a refund may reduce what you owe.</p>
      </section>
      <section id="questions" aria-labelledby="q-t">
        <h2 id="q-t">Barclays overdraft questions</h2>
        <FaqList faqs={faqs} name="lender-faq" />
      </section>
      <section id="sources" class="sources" aria-labelledby="src-t">
        <h2 id="src-t">Sources</h2>
        <ul>
          <li><a href="https://www.financial-ombudsman.org.uk/" rel="noopener">Financial Ombudsman Service</a></li>
          <li><a href="https://register.fca.org.uk/" rel="noopener">FCA Financial Services Register</a></li>
        </ul>
      </section>
    </article>
    <aside class="side">
      <div class="start">
        <h2>Start your Barclays claim</h2>
        <p>Four questions. About a minute.</p>
        <a class="btn btn-tan" href="/check/?borrow=overdraft">Check if I can claim</a>
        <small>You can complain to Barclays and the Financial Ombudsman yourself for free.</small>
      </div>
      <nav class="card box" aria-label="On this page">
        <h2>On this page</h2>
        <ol><li><a href="#who">Who are Barclays?</a></li><li><a href="#claim">Can I claim?</a></li><li><a href="#back">What you could get back</a></li><li><a href="#questions">Questions</a></li><li><a href="#sources">Sources</a></li></ol>
      </nav>
      <nav class="card box" aria-label="Related guides">
        <h2>Related guides</h2>
        <ul><li><a href="/guides/">When should your bank have stepped in?</a></li><li><a href="/guides/">Will claiming affect my credit file?</a></li></ul>
      </nav>
    </aside>
  </div>

  <section class="wrap others" aria-labelledby="oth-t">
    <h2 id="oth-t">Other banks</h2>
    <ul class="chips">{others.map((l) => <li><a href={lenderHref(l.slug)}>{l.name}</a></li>)}</ul>
  </section>
</Base>

<style>
  .lhero { padding: 40px 0 128px; }
  .lgrid { display: grid; grid-template-columns: minmax(0,1fr) 400px; gap: 56px; align-items: start; }
  .lcopy { display: flex; flex-direction: column; gap: 22px; }
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--on-2); }
  .crumbs li + li::before { content: '/'; margin-right: 8px; color: var(--on-line); }
  .crumbs a { color: var(--on-2); }
  .lhero h1 { font-size: 60px; color: var(--on); }
  .answer { background: rgba(255,255,255,.06); border: 1px solid var(--on-line); border-radius: var(--rm); padding: 22px 24px; max-width: 680px; display: flex; flex-direction: column; gap: 8px; }
  .answer .eb { color: var(--tan); }
  .answer p:last-child { font-size: 18px; line-height: 1.55; color: var(--on); }
  .lck { background: var(--card); color: var(--text); border-radius: var(--rl); padding: 26px; box-shadow: 0 30px 60px rgba(6,10,16,.35); display: flex; flex-direction: column; gap: 14px; }
  .lck h2 { font-size: 23px; }
  .lq { font-weight: 700; font-size: 16px; }
  .lopts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .lopts a { display: flex; align-items: center; min-height: 56px; padding: 8px 14px; border: 1.5px solid var(--line); border-radius: var(--rs); font-weight: 700; font-size: 15px; color: var(--slate); text-decoration: none; }
  .lopts a:hover { border-color: var(--slate); }
  .lck small { font-size: 13px; line-height: 1.45; color: var(--muted); }
  .llift { margin-top: -72px; position: relative; z-index: 3; }
  .facts { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); margin: 0; box-shadow: 0 20px 50px rgba(27,36,48,.08); overflow: hidden; }
  .facts div { padding: 22px 24px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .facts div:last-child { border-right: 0; }
  .facts dt { font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .facts dd { margin: 0; font-weight: 800; font-size: 18px; line-height: 1.25; color: var(--slate); }
  .article { display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 32px; align-items: start; margin-top: 32px; }
  .panel { padding: 52px 56px; display: flex; flex-direction: column; gap: 48px; }
  .panel section { display: flex; flex-direction: column; gap: 16px; max-width: 660px; scroll-margin-top: 24px; }
  .panel h2 { font-size: 30px; }
  .panel section > p { color: var(--text-2); }
  .nlist li { font-size: 18px; padding: 14px 0; }
  .note { font-size: 15px; color: var(--muted); background: var(--bg); border-radius: var(--rs); padding: 14px 16px; }
  .note b { color: var(--slate); }
  .lput { padding: 24px 26px 16px; transform: rotate(-.8deg); max-width: 520px; box-shadow: 0 20px 44px rgba(18,24,32,.12); }
  .lput .pr:last-child { border-bottom: 0; }
  .sources ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
  .side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 24px; }
  .start { background: var(--slate); color: var(--on); border-radius: var(--rm); padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .start h2 { font-size: 21px; color: var(--on); }
  .start p { font-size: 15px; color: var(--on-2); }
  .start .btn { width: 100%; }
  .start small { font-size: 12px; line-height: 1.45; color: var(--on-2); }
  .box { padding: 20px 22px; }
  .box h2 { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  .box ol, .box ul { list-style: none; margin: 0; padding: 0; }
  .box a { display: block; padding: 9px 0; color: var(--slate); font-weight: 600; font-size: 15px; text-decoration: none; border-bottom: 1px solid #F1F2F3; }
  .box li:last-child a { border-bottom: 0; }
  .box a:hover { color: var(--tan-deep); }
  .others { margin-top: 96px; }
  .others h2 { font-size: 32px; margin-bottom: 20px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: block; padding: 9px 16px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); font-weight: 600; font-size: 15px; color: var(--slate); text-decoration: none; }
  .chips a:hover { border-color: var(--tan); }
  @media (max-width: 760px) {
    .lhero { padding: 22px 0 100px; }
    .lgrid { grid-template-columns: minmax(0,1fr); gap: 24px; }
    .lhero h1 { font-size: 36px; }
    .answer { padding: 18px; }
    .answer p:last-child { font-size: 16px; }
    .lck { padding: 20px; border-radius: 24px; }
    .llift { margin-top: -64px; }
    .facts { grid-template-columns: 1fr 1fr; }
    .facts div { padding: 16px; }
    .facts div:nth-child(2) { border-right: 0; }
    .facts div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
    .facts dd { font-size: 15px; }
    .article { grid-template-columns: minmax(0,1fr); gap: 16px; margin-top: 16px; }
    .panel { padding: 24px 20px; gap: 36px; }
    .panel h2 { font-size: 25px; }
    .nlist li { font-size: 16px; }
    .lput { padding: 18px 16px 12px; }
    .side { position: static; }
    .others { margin-top: 64px; }
    .others h2 { font-size: 26px; }
    .chips a { font-size: 14px; padding: 8px 14px; }
  }
</style>
